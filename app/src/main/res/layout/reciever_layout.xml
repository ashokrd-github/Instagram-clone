<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="100dp"
    android:orientation="vertical"
    android:gravity="end"
    android:layout_gravity="end">

    <LinearLayout
        android:id="@+id/mLinear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="5dp">



        <TextView
            android:id="@+id/receive_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:paddingHorizontal="10dp"
            android:text="receive the message"
            android:padding="8dp"
            android:background="@drawable/sender"
            android:textStyle="bold"
            android:textSize="16sp"/>



    </LinearLayout>
    <ImageView
        android:id="@+id/sent_image"
        android:layout_width="200dp"
        android:layout_height="300dp"
        android:background="@drawable/sender"
        android:backgroundTint="@color/shimmerColors"
        android:layout_margin="5dp"
        android:visibility="gone"
        android:scaleType="centerCrop"
        android:src="@drawable/picture"/>


    <FrameLayout
        android:id="@+id/sent_frame"
        android:layout_width="220dp"
        android:layout_height="250dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="horizontal"
        android:background="@drawable/btn_profile"
        android:backgroundTint="@color/shimmerColors"
        android:layout_marginTop="5dp"
        android:visibility="gone"
        android:layout_marginEnd="5dp"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="220dp"
            android:layout_height="250dp">

            <VideoView
                android:id="@+id/sent_videoView"
                android:layout_width="180dp"
                android:layout_height="230dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ProgressBar
                android:id="@+id/sentP_reel"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/circie_btn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/video"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="5dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>



    <TextView
        android:id="@+id/sentTime"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:layout_gravity="end"
        android:gravity="end"
        android:textColor="@color/text"
        android:visibility="gone"
        android:layout_marginEnd="5dp"
       android:textStyle="bold"
        android:text="receive Time"/>
</LinearLayout>