<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:id="@+id/app_bar_layout_profile"
        >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/profile_toolbar"
            android:layout_height="50dp"
            android:layout_width="match_parent"
            android:background="@color/shimmerColors"
            android:layout_alignParentStart="true"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/profile_toolbar_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                   android:background="@color/shimmerColors"
                    android:textAlignment="center"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:layout_centerVertical="true"
                    />
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/app_bar_layout_profile">

        <LinearLayout
            android:id="@+id/top_bar_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/top_bar_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profile_image_profile"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="10dp"
                    android:elevation="12dp"
                    android:background="@drawable/circie_btn"
                    android:backgroundTint="@color/shimmerColors">
                </de.hdodenhof.circleimageview.CircleImageView>

                <LinearLayout
                    android:id="@+id/edit_profile_vertical"
                    android:layout_width="282dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/edit_profile_horizontal"
                        android:layout_width="254dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="5dp"
                        android:elevation="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="1dp"
                            android:background="@drawable/btn_profile"
                            android:backgroundTint="@color/shimmerColors"
                            android:gravity="center"
                            android:paddingHorizontal="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/total_posts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/title_posts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="25dp"
                            android:gravity="center"
                            android:backgroundTint="@color/shimmerColors"
                            android:background="@drawable/btn_profile"
                            android:paddingHorizontal="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/total_reels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/title_reels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/Followers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="25dp"
                            android:gravity="center"
                            android:elevation="12dp"
                            android:background="@drawable/btn_profile"
                            android:backgroundTint="@color/shimmerColors"
                            android:paddingHorizontal="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/total_followers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/title_followers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/Following"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:backgroundTint="@color/shimmerColors"
                            android:background="@drawable/btn_profile"
                            android:paddingHorizontal="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/total_following"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/title_following"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/edit_profile_Button"
                        android:layout_width="150dp"
                        android:layout_height="45dp"
                        android:layout_marginEnd="10dp"
                        android:backgroundTint="@color/shimmerColors"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/fullname_in_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
               android:backgroundTint="@color/shimmerColors"
                android:background="@drawable/btn_profile"
                android:textSize="15dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/username_in_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:textColor="@color/text"
                android:backgroundTint="@color/shimmerColors"
                android:background="@drawable/btn_profile"
                android:textSize="12dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bio_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:padding="6dp"
                android:backgroundTint="@color/shimmerColors"
                android:background="@drawable/btn_profile"
                android:textSize="16dp"
                android:textStyle="bold" />



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="5dp"
                android:background="@drawable/btn_profile"
                android:layout_marginRight="5dp"
                >

                <ImageButton
                    android:id="@+id/postGrid"
                    android:layout_width="1dp"
                    android:layout_height="49dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="5dp"
                    android:background="@color/shimmerColors" />

                <ImageButton
                    android:id="@+id/images_save_btn"
                    android:layout_width="1dp"
                    android:layout_height="49dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="5dp"
                    android:background="@color/shimmerColors" />

                <ImageButton
                    android:id="@+id/reelGrid"
                    android:layout_width="1dp"
                    android:layout_height="49dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:background="@color/shimmerColors" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>